<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 保活引导：申请忽略电池优化（Doze 白名单） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 捕获通知：检测到动账/退款时发系统通知提醒确认（安卓 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 银行动账短信：只收新到短信（不读历史、非默认短信应用）；设置里默认关，开启时运行时申请 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- 悬浮确认卡：在支付页上方弹出预填确认卡片（底部卡，用户在设置里单独授权；未授权自动回落通知） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 自动更新：启动时查 GitHub Release 最新版；确认更新后应用内下载 APK 并拉起系统安装（只读不上传） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 应用内更新：确认后由应用下载 APK 并调起系统安装器（安装前系统会再弹确认，用户可拒） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 各品牌自启动/安全中心页面包可见性（Android 11+ 显式跳转其他应用组件需要声明） -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
    </queries>

    <application
        android:name=".AccBookApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 长按图标快捷方式：记一笔 / 待确认 / 账单导入（复用通知跳转的 route 契约） -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <!-- 分享入口：把账单文件（csv/xlsx）分享到 易控钱包 → 落盘缓存 → 跳账单导入并预解析 -->
        <activity
            android:name=".ShareImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
        </activity>

        <!-- 快捷设置磁贴「记一笔」 -->
        <service
            android:name=".capture.QuickAddTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_add"
            android:label="记一笔"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 应用内更新：把下载的 APK 通过 content:// 交给系统安装器（不导出、按需授权） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 阶段二：通知监听采集（用户在系统设置授予"通知使用权"后由系统绑定） -->
        <service
            android:name=".capture.NotificationCaptureService"
            android:exported="false"
            android:label="通知捕获"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          无障碍页面采集（用户在系统无障碍设置开启后由系统绑定；仅读窗口内容）。
          注册的组件是入口子类 `com.google.android.accessibility.selecttospeak.SelectToSpeakService`，
          它只继承、不新增任何采集逻辑；事件处理与节点读取全部在
          `com.controleco.app.capture.AccBookAccessibilityService`（见 docs/无障碍页面捕获兼容性.md）。
          APK 内**只有这一个**页面采集组件：父类不再单独声明，避免出现两套同时运行的服务。
          系统设置里显示的名称/说明来自 @string/a11y_service_label / a11y_service_description（ControlECO 自己）。
        -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 银行动账短信采集：只收新到短信；不做 abortBroadcast，不干扰系统短信应用与用户通知 -->
        <receiver
            android:name=".capture.SmsCaptureReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 金额待补录：通知栏「输入金额」的 RemoteInput 回复入口（不导出；接收器内做来源校验） -->
        <receiver
            android:name=".capture.AmountReplyReceiver"
            android:exported="false" />

        <!-- 通知栏「忽略」action：一键丢弃误报的待确认条目（不导出） -->
        <receiver
            android:name=".capture.CaptureActionReceiver"
            android:exported="false" />

        <!-- 覆盖安装后：检测 versionCode 变化，提示复查通知使用权（更新后监听可能静默失效） -->
        <receiver
            android:name=".capture.PackageReplacedReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
